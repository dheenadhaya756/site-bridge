# Required: your Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Model used to understand the site (one call per scan) and to power the chat agent.
# Flash-Lite keeps a full scan well under 1-2 rupees.
GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_CHAT_MODEL=gemini-flash-latest

# Pricing used for the cost meter (USD per 1M tokens) and the exchange rate.
GEMINI_PRICE_IN_PER_M=0.10
GEMINI_PRICE_OUT_PER_M=0.40
USD_INR=88

# Hard cap on Gemini spend per day (India time) for chat + scans, in rupees. 0 = no cap.
DAILY_BUDGET_INR=10

# Crawl limits
# Scans read the home page fully, then the basics of linked pages for up to CRAWL_SECONDS
MAX_PAGES=40
CRAWL_SECONDS=25
DIGEST_CHARS=48000

# Ports. The live preview runs on its own port, one subdomain per site
# (e.g. http://acme-com-x1y2.localhost:4101). In production point a wildcard
# DNS record like *.preview.yourdomain.com at this server.
PORT=4100
PREVIEW_PORT=4101
# PUBLIC_URL=http://localhost:4100
# PREVIEW_URL_TEMPLATE=http://{id}.localhost:4101

# Set to 1 only for local testing against sites on your own network.
ALLOW_PRIVATE_URLS=0

# Render JavaScript-heavy pages with a headless browser when plain HTML is empty.
# Needs: npm i playwright && npx playwright install chromium
RENDER_JS=1

# Chat guardrails (all optional). CHAT_SECRET signs the conversation history so visitors
# can't forge earlier turns; when empty a random secret is written to data/chat-secret.
# Rate limits are requests per minute / per hour, per visitor IP and per site.
# CHAT_SECRET=
# CHAT_MAX_MESSAGE_CHARS=2000
# CHAT_RATE_PER_MIN=20
# CHAT_RATE_PER_HOUR=300
# CHAT_SITE_RATE_PER_MIN=120
# CHAT_SITE_RATE_PER_HOUR=2000
# Set to 1 behind a reverse proxy (nginx, Cloudflare) so rate limits see the real visitor IP.
# TRUST_PROXY=1

# Where the website's "Talk to Us" buttons send enquiries
CONTACT_EMAIL=

# SMTP for sign-in emails (e.g. Gmail with an app password); used instead of Resend when set
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_FROM=Site Bridge <you@gmail.com>
